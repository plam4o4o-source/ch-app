<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Известия (Android 13+): искат се едва когато потребителят включи известие. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Скенер на баркодове (ISBN / инвентарен номер): иска се едва при отваряне на скенера;
         кадрите се обработват само на устройството. Камерата не е задължителна. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Самообновяване от GitHub Releases (APK извън Google Play). Play build-ът
         премахва тези разрешения — виж src/play/AndroidManifest.xml. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Отваряне на телефон, имейл, карта и календар. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Браузърът за адресите на сайта: те са App Links на приложението (виж Intents.openUrl). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".ChitalishteApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Chitalishte"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/launcher_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Chitalishte.Splash"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Links: адресите от chyavorec.org, за които приложението има екран (виж
                 DeepLinks.forUrl), се отварят направо в него. Сайтът публикува
                 /.well-known/assetlinks.json за org.chyavorec.app. Само каноничният адрес без
                 www (така са sitemap.xml и canonical на сайта); всички останали пътища
                 (търсене, javora, изтриване на акаунт, файлове) остават в браузъра. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="chyavorec.org" />
                <data android:path="/" />
                <data android:path="/news" />
                <data android:path="/elektronen-katalog" />
                <data android:path="/events" />
                <data android:path="/kontakti" />
                <data android:path="/load" />
                <data android:path="/istoricheski-publikacii" />
                <data android:path="/policy" />
                <data android:path="/about" />
                <data android:path="/history" />
                <data android:path="/library" />
                <data android:path="/folklorna-grupa" />
                <data android:path="/yavorski-hlapeta" />
                <data android:path="/tancov-klub" />
                <data android:path="/klubove-i-krzhoci" />
                <data android:path="/proekti" />
                <data android:path="/darenija" />
                <data android:path="/fotodokumentalna-izlozhba" />
                <data android:path="/selo-yavorec" />
                <data android:path="/nature" />
                <data android:path="/dostapnost" />
                <data android:pathPrefix="/news/" />
            </intent-filter>
            <!-- Статични преки пътища при задържане на иконата (отделен файл за всеки flavor
                 заради различния applicationId). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Уиджет за началния екран: следващо събитие и срок за връщане. -->
        <receiver
            android:name=".widget.ChitalishteWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Резултат от инсталирането на обновление (само от системата). -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- WorkManager се инициализира от ChitalishteApp (Configuration.Provider). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
