<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Chitalishte" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Chitalishte" parent="Base.Theme.Chitalishte">
        <item name="android:navigationBarColor">@color/system_bar_scrim_dark</item>
    </style>

    <style name="Theme.Chitalishte.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_ink</item>
        <!-- Медальонът от иконата в лаунчера върху бордо кръг; на Android 12+ пръстенът се
             изрисува (drawable-v31/splash_icon.xml), по-старите показват същия знак неподвижен. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">650</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_burgundy</item>
        <!-- Иконите в лентите още по време на заставката (преди Compose) — за фона ѝ. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="postSplashScreenTheme">@style/Theme.Chitalishte</item>
    </style>
</resources>
