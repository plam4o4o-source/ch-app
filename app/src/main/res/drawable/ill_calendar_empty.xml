    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="3" android:strokeLineCap="round"
        android:pathData="M58,22L58,36M102,22L102,36" />
    <!-- мрежа на дните (празна) -->
    <path android:strokeColor="#80FFFFFF" android:strokeWidth="2" android:strokeLineCap="round"
        android:pathData="M52,58L68,58M76,58L92,58M100,58L110,58M52,72L68,72M76,72L92,72M100,72L110,72M52,86L68,86" />
    <!-- клонче с листа, облегнато на листа -->
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="3" android:strokeLineCap="round"
        android:pathData="M118,98C124,84 130,74 142,66" />
    <path android:fillColor="#B3FFFFFF"
        android:pathData="M126,84C122,76 126,70 134,70C134,78 130,84 126,84ZM131,76C128,66 134,60 142,60C142,68 137,76 131,76ZM120,92C114,88 114,80 120,76C124,82 124,88 120,92Z" />
