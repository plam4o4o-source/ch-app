<!-- Илюстрация за „няма събития“: лист от календар с клонче (линеен стил като логото).
     Оцветява се от темата (ColorFilter.tint), затова цветовете са бели с различна плътност. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="160dp"
    android:height="120dp"
    android:viewportWidth="160"
    android:viewportHeight="120">
    <!-- мек ореол -->
    <path android:fillColor="#1FFFFFFF"
        android:pathData="M80,60m-58,0a58,50 0,1 1,116 0a58,50 0,1 1,-116 0" />
    <!-- лист на календара (пълнеж) -->
    <path android:fillColor="#40FFFFFF"
        android:pathData="M40,30L120,30L120,100L40,100Z" />
    <!-- горна лента (дните от седмицата) -->
    <path android:fillColor="#66FFFFFF"
        android:pathData="M40,30L120,30L120,44L40,44Z" />
    <!-- контур на листа -->
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="3" android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M40,30L120,30L120,100L40,100ZM40,44L120,44" />
