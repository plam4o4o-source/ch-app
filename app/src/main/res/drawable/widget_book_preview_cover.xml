<?xml version="1.0" encoding="utf-8"?>
<!-- Статична корица за прегледа на „Книга на деня“ (Android 12–14): бордо, златна рамка и лента — като генерираната. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#FF4E141D"
                android:startColor="#FF8A3340" />
            <corners
                android:bottomLeftRadius="3dp"
                android:bottomRightRadius="8dp"
                android:topLeftRadius="3dp"
                android:topRightRadius="8dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="9dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:bottom="30dp"
        android:gravity="bottom"
        android:height="1dp"
        android:left="12dp"
        android:right="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#C7E8D5A3" />
        </shape>
    </item>
    <item
        android:bottom="16dp"
        android:gravity="bottom"
        android:height="1dp"
        android:left="12dp"
        android:right="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#C7E8D5A3" />
        </shape>
    </item>
</layer-list>
