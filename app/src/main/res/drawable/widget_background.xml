<?xml version="1.0" encoding="utf-8"?>
<!--
  Фон на уиджета: пергамент (нощем — тъмно мастило), златен кант, заоблени ъгли и долу —
  5 dp верига от ромбове на кръстат бод (повтаряща се плочка widget_ribbon, бод 1 dp,
  tools/gen_widget_ribbon.py) като подгъв точно над канта. Динамичният вариант е widget_dyn_background.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_bg" />
            <stroke android:width="1dp" android:color="@color/widget_stroke" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:end="20dp"
        android:gravity="bottom|fill_horizontal"
        android:height="5dp"
        android:start="20dp">
        <bitmap
            android:src="@drawable/widget_ribbon"
            android:tileMode="repeat" />
    </item>
</layer-list>
