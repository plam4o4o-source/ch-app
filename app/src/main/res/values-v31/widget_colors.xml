<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: динамичните цветове на системата (Material You) — ролите на Material 3
  върху тоновете system_* (както GlanceTheme досега); тъмните са във values-night-v31.
  Без златен кант. Просрочена книга — постоянните цветове за грешка на Material 3.
-->
<resources>
    <color name="widget_bg">@android:color/system_neutral1_10</color>
    <color name="widget_stroke">@android:color/transparent</color>
    <color name="widget_title">@android:color/system_accent1_600</color>
    <color name="widget_text">@android:color/system_neutral1_900</color>
    <color name="widget_muted">@android:color/system_neutral2_700</color>
    <color name="widget_event_date">@android:color/system_accent2_600</color>
    <color name="widget_button_bg">@android:color/system_accent1_600</color>
    <color name="widget_button_text">@android:color/system_accent1_0</color>
    <color name="widget_tonal_bg">@android:color/system_accent2_100</color>
    <color name="widget_tonal_text">@android:color/system_accent2_900</color>
    <color name="widget_overdue_bg">#FFF9DEDC</color>
    <color name="widget_overdue_text">#FF410E0B</color>
    <color name="widget_soon_bg">@android:color/system_accent3_100</color>
    <color name="widget_soon_text">@android:color/system_accent3_900</color>
    <color name="widget_ok_bg">@android:color/system_accent1_100</color>
    <color name="widget_ok_text">@android:color/system_accent1_900</color>
</resources>
