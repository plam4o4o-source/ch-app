<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 11+: прозрачни ленти; при 3 бутона системата сама слага фон зад тях. -->
    <style name="Theme.Chitalishte" parent="Base.Theme.Chitalishte">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">true</item>
        <!-- Съдържанието и под изрязването за камерата (отстъпите се спазват в Compose). -->
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
