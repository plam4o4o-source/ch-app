<?xml version="1.0" encoding="utf-8"?>
<!-- Анимирана икона на splash екрана (Android 12+): медальонът от иконата в лаунчера
     (ic_launcher_foreground — геометрията е същата, тук е повторена, защото animated-vector
     анимира само собствените си пътища). Златният пръстен се изрисува от върха по часовника,
     книгата леко „израства“ — общо 650 ms. Книгата се вижда от първия кадър: ако системата не
     изпълни анимацията, знакът пак се разпознава. Фонът на иконата е бордото
     (windowSplashScreenIconBackgroundColor), видимият кръг е 2/3 от платното — както в лаунчера.
     Под Android 12 — статичната икона (drawable/splash_icon.xml). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <!-- лека сянка под медальона -->
            <path
                android:fillColor="#38000000"
                android:pathData="M54,24.4a30.6,30.6 0,1 1,0 61.2a30.6,30.6 0,1 1,0 -61.2z" />
            <!-- по-тъмно бордо в пръстена -->
            <path
                android:fillColor="#FF5C1A24"
                android:pathData="M54,27.5a26.5,26.5 0,1 1,0 53a26.5,26.5 0,1 1,0 -53z" />
            <!-- златният пръстен; trimPathEnd 0 → 1 го изрисува -->
            <path
                android:name="ring"
                android:strokeColor="#FFC9A84C"
                android:strokeWidth="3.5"
                android:trimPathEnd="0"
                android:pathData="M54,25.75a28.25,28.25 0,1 1,0 56.5a28.25,28.25 0,1 1,0 -56.5" />
            <group
                android:name="book"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.88"
                android:scaleY="0.88">
                <group
                    android:scaleX="1.75"
                    android:scaleY="1.75"
                    android:translateX="33"
                    android:translateY="30.64">
                    <path
                        android:fillColor="#FFFAF7F2"
                        android:fillType="evenOdd"
                        android:pathData="M3,6.2C5.3,5 8.2,4.6 11.2,5.4V19.2C8.4,18.4 5.6,18.6 3,19.6ZM4.8,8.6h4.8v0.9h-4.8zM4.8,10.9h4.8v0.9h-4.8zM4.8,13.2h4.8v0.9h-4.8zM4.8,15.5h3.6v0.9h-3.6zM12.8,5.4C15.8,4.6 18.7,5 21,6.2V19.6C18.4,18.6 15.6,18.4 12.8,19.2ZM14.4,8.6h4.8v0.9h-4.8zM14.4,10.9h4.8v0.9h-4.8zM14.4,13.2h4.8v0.9h-4.8zM15.6,15.5h3.6v0.9h-3.6z" />
                    <path
                        android:fillColor="#FFC9A84C"
                        android:pathData="M1.5,8.2H2.3V20.8C5.6,19.6 8.9,19.6 12,20.9C15.1,19.6 18.4,19.6 21.7,20.8V8.2H22.5V21.9C19,20.6 15.4,20.6 12,22.1C8.6,20.6 5,20.6 1.5,21.9Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="650"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="book">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="450"
                    android:startOffset="200"
                    android:interpolator="@android:interpolator/linear_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.88"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="450"
                    android:startOffset="200"
                    android:interpolator="@android:interpolator/linear_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.88"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
