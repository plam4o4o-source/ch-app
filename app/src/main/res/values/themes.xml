<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- От край до край без оттеглени API в кода (виж ui/theme/SystemBars.kt): лентите са
         прозрачни по тема. Android 8.0 не може тъмни икони в навигационната лента — там тя е
         с тъмен полупрозрачен фон; от 8.1 (values-v27) — светъл, от 10 (values-v29) — прозрачна,
         а фона зад 3-те бутона рисува системата. Изрязването за камерата — values-v30. -->
    <style name="Base.Theme.Chitalishte" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Chitalishte" parent="Base.Theme.Chitalishte">
        <item name="android:navigationBarColor">@color/system_bar_scrim_dark</item>
    </style>

    <style name="Theme.Chitalishte.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_cream</item>
        <!-- Медальонът от иконата в лаунчера върху бордо кръг; на Android 12+ пръстенът се
             изрисува (drawable-v31/splash_icon.xml), по-старите показват същия знак неподвижен. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">650</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_burgundy</item>
        <item name="postSplashScreenTheme">@style/Theme.Chitalishte</item>
    </style>
</resources>
