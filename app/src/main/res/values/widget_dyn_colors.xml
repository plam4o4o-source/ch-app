<?xml version="1.0" encoding="utf-8"?>
<!--
  Динамичните цветове на уиджета (само при включено „Цветове от тапета“, Android 12+): тук —
  връзки към фирмените (за ресурсите да има стойност във всяка конфигурация, а до Android 12
  динамични няма); истинските са във values-v31 и values-night-v31 (widget_dyn_colors.xml).
-->
<resources>
    <color name="widget_dyn_bg">@color/widget_bg</color>
    <color name="widget_dyn_title">@color/widget_title</color>
    <color name="widget_dyn_text">@color/widget_text</color>
    <color name="widget_dyn_muted">@color/widget_muted</color>
    <color name="widget_dyn_event_date">@color/widget_event_date</color>
    <color name="widget_dyn_button_bg">@color/widget_button_bg</color>
    <color name="widget_dyn_button_text">@color/widget_button_text</color>
    <color name="widget_dyn_tonal_bg">@color/widget_tonal_bg</color>
    <color name="widget_dyn_tonal_text">@color/widget_tonal_text</color>
    <color name="widget_dyn_overdue_bg">@color/widget_overdue_bg</color>
    <color name="widget_dyn_overdue_text">@color/widget_overdue_text</color>
    <color name="widget_dyn_soon_bg">@color/widget_soon_bg</color>
    <color name="widget_dyn_soon_text">@color/widget_soon_text</color>
    <color name="widget_dyn_ok_bg">@color/widget_ok_bg</color>
    <color name="widget_dyn_ok_text">@color/widget_ok_text</color>
</resources>
