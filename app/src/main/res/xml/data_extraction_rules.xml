<?xml version="1.0" encoding="utf-8"?>
<!-- Нищо не се архивира в облака и не се прехвърля към друго устройство:
     сесията е шифрована с ключ от Android Keystore, който не напуска устройството. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
