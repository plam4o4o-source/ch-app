<?xml version="1.0" encoding="utf-8"?>
<!--
  Заглавката на уиджета: емблемата (18 dp, върху бял кръг) и името — цяло, кратко или
  скрито (тогава емблемата получава описание за TalkBack), по ширината (WidgetViews).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:background="@drawable/widget_logo_bg"
        android:contentDescription="@null"
        android:padding="1dp"
        android:src="@drawable/logo_chitalishte_small" />

    <TextView
        android:id="@+id/widget_title"
        style="@style/Widget.Chitalishte.Text.Title"
        android:layout_marginStart="6dp"
        android:text="@string/widget_label" />
</LinearLayout>
