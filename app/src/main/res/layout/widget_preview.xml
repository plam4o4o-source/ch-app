<?xml version="1.0" encoding="utf-8"?>
<!--
  Преглед на уиджета в избора на уиджети (android:previewLayout, Android 12–14): широкият
  вариант (layout/widget_wide, същите стилове) с примерните данни — срок, следващо събитие
  и бутоните „Сканирай“/„Каталог“. Без заглавия на книги. От Android 15 прегледът се
  генерира от самото оформление (WidgetUpdater.publishPreview) със същите примерни текстове.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/Widget.Chitalishte.Root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <include
            layout="@layout/widget_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            style="@style/Widget.Chitalishte.Text.Button"
            android:text="@string/shortcut_scan" />

        <TextView
            style="@style/Widget.Chitalishte.Text.Button.Tonal"
            android:layout_marginStart="6dp"
            android:text="@string/shortcut_catalog" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="6dp">

            <TextView
                style="@style/Widget.Chitalishte.Text.Label"
                android:text="@string/widget_preview_books" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Chitalishte.Text.Chip"
                    android:background="@drawable/widget_chip_soon"
                    android:text="@string/widget_preview_due"
                    android:textColor="@color/widget_soon_text" />

                <TextView
                    style="@style/Widget.Chitalishte.Text"
                    android:layout_marginStart="6dp"
                    android:text="@string/widget_preview_date" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView
                style="@style/Widget.Chitalishte.Text.Label"
                android:text="@string/widget_next_event" />

            <TextView
                style="@style/Widget.Chitalishte.Text.EventTitle"
                android:text="@string/widget_preview_event" />

            <TextView
                style="@style/Widget.Chitalishte.Text.EventDate"
                android:text="@string/widget_preview_event_date" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
