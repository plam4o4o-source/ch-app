text="" resource-id="" class="android.view.View" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1600,2560]"><node index="0" text="" resource-id="" class="android.view.View" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1600,2560]"><node index="0" text="" resource-id="" class="android.view.View" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1600,2560]"><node index="0" text="" resource-id="" class="android.widget.ScrollView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[85,176][1600,2440]"><node index="0" text="" resource-id="" class="android.view.View" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[125,216][827,312]"><node index="0" text="Виж и: Политика за поверителност" resource-id="" class="android.widget.TextView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[237,244][779,284]" /><node index="1" text="" resource-id="" class="android.widget.Button" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[125,224][827,304]" /></node><node index="1" text="Последна актуализация: 7 ноември 2026 г." resource-id="" class="android.widget.TextView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[125,344][799,381]" /><node index="2" text="Кой обработва данните" resource-id="" class="android.widget.TextView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[125,417][574,471]" /><node index="3" text="Приложението „Читалище Яворец“ е официалното мобилно приложение на Народно читалище „Васил Левски – 1922“, с. Яворец, общ. Габрово (наричано по-долу „читалището“). Връзка: chitalishte_yavorec@abv.bg." resource-id="" class="android.widget.TextView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[125,491][1560,628]" /><node index="4" text="Принцип" resource-id="" class="android.widget.TextView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[125,664][293,718]" /><node index="5" text="Приложението събира възможно най-малко данни. То няма реклами, няма анализ на поведението (analytics), няма услуги за проследяване и не изпраща отчети за сривове към трети страни." resource-id="" class="android.widget.TextView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[125,738][1560,875]" /><node index="6" text="Какви данни се обработват" resource-id="" class="android.widget.TextView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[125,911][641,965]" /><node index="7" text="Публично съдържание: новините, събитията, снимките и страниците се зареждат от сайта chyavorec.org, а библиотечният каталог — от публичния файл katalog.json на системата InvLib, хостван в GitHub (raw.githubusercontent.com и cdn.jsdelivr.net). При всяка такава заявка съответният сървър вижда IP адреса на устройството, както при посещение на обикновен уебсайт. Каталогът не съдържа лични данни на читатели. Кориците на книгите в публичния каталог се зареждат по ISBN от covers.openlibrary.org (Internet Archive) — този сървър вижда IP адреса и ISBN-а, нищо друго; ако в каталога е посочена сканирана корица, тя се зарежда от адреса, записан в каталога, и съответният сървър вижда IP адреса. И двете се изключват от „Настройки › Данни › Корици от интернет“. В личните екрани (история на четенето, заети книги, „Искам да прочета“, „За теб“, картата, както и страницата на книга, отворена от тях) корици от интернет не се зареждат никога — там кориците се рисуват на телефона." resource-id="" class="android.widget.TextView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[125,985][1560,1572]" /><node index="8" text="Съобщения от читалището: приложението проверява публичния файл със съобщения на chyavorec.org най-често веднъж на час (по-рядко — до веднъж на 6 часа, докато няма нови съобщения) и спира проверките, ако не е отваряно 14 дни. Съобщенията „само за членове“ се показват, ако на устройството е въведена читателска карта или след вход — тази проверка е на устройството и нищо не се изпраща към сайта. Прочетените съобщения се помнят само на устройството." resource-id="" class="android.widget.TextView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[125,1592][1560,1879]" /><node index="9" text="Лични съобщения от библиотеката: след вход, ако сървърът на читалището го поддържа, библиотеката може да ти изпрати лично съобщение (напр. за запазена книга). То идва по HTTPS от сървъра на читалището, пази се шифровано на телефона и се изтрива при изход; отбелязването „прочетено“ се изпраща към същия сървър. Известието за ново лично съобщение се подготвя на телефона; когато заключеният екран е настроен да скрива чувствително съдържание, там то показва само „Имаш лично съобщение от библиотеката“, без съдържанието." resource-id="" class="android.widget.TextView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[125,1899][1560,2236]" /><node index="10" text="Обновления: версията, инсталирана извън Google Play, проверява за нова версия във файла update.json в GitHub (github.com) и изтегля новата версия оттам. Изпраща се само обикновена заявка (IP адресът е видим за GitHub); не се изпращат лични данни. Автоматичното обновяване се изключва от „Настройки › Обновления“. Версията от Google Play се обновява от Google Play." resource-id="" class="android.widget.TextView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[125,2256][1560,2440]" /></node><node index="1" text="" resource-id="" class="android.view.View" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1600,176]"><node index="0" text="" resource-id="" class="android.view.View" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[85,48][1600,176]"><node index="0" text="" resource-id="" class="android.view.View" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[93,64][189,160]"><node index="0" text="" resource-id="" class="android.view.View" package="org.chyavorec.app" content-desc="Назад" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[117,88][165,136]" /><node index="1" text="" resource-id="" class="android.widget.Button" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[101,72][181,152]" /></node><node index="1" text="" resource-id="" class="android.view.View" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled