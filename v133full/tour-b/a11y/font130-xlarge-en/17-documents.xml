 обществени събития, насочени към развитие на местната общност, съхраняване на традициите и подпомагане на гражданската активност. Отчетът осигурява прозрачност, отговорност и ясна представа за развитието на организацията през отчетния период." resource-id="" class="android.widget.TextView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[147,1603][870,1882]" /><node index="3" text="" resource-id="" class="android.view.View" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[913,1296][1039,1422]"><node index="0" text="" resource-id="" class="android.view.View" package="org.chyavorec.app" content-desc="Open with a PDF app" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[944,1327][1007,1390]" /><node index="1" text="" resource-id="" class="android.widget.Button" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[923,1306][1028,1411]" /></node></node><node index="2" text="" resource-id="" class="android.view.View" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1913][1080,2337]"><node index="0" text="Учредителни документи · Apr 30, 2026 · 988.2 Kb" resource-id="" class="android.widget.TextView" package="org.chyavorec.app" conten