 обществени събития, насочени към развитие на местната общност, съхраняване на традициите и подпомагане на гражданската активност. Отчетът осигурява прозрачност, отговорност и ясна представа за развитието на организацията през отчетния период." resource-id="" class="android.widget.TextView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[147,898][870,1066]" /><node index="3" text="" resource-id="" class="android.view.View" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[913,808][1039,934]"><node index="0" text="" resource-id="" class="android.view.View" package="org.chyavorec.app" content-desc="Отвори с приложение за PDF" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[944,839][1007,902]" /><node index="1" text="" resource-id="" class="android.widget.Button" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[923,818][1028,923]" /></node></node><node index="2" text="" resource-id="" class="android.view.View" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1097][1080,1461]"><node index="0" text="Учредителни документи · 30.04.2026 · 988.2 Kb" resource-id="" class="android.widget.TextView" package="org.chyavorec.app" content-