droid.widget.TextView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1165][1027,1412]" /><node index="6" text="What data is processed" resource-id="" class="android.widget.TextView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1459][562,1529]" /><node index="7" text="Public content: news, events, photos and pages are loaded from chyavorec.org, and the library catalogue from the public katalog.json file of the InvLib system hosted on GitHub (raw.githubusercontent.com and cdn.jsdelivr.net). Each such server sees the device’s IP address, as with any website visit. The catalogue contains no reader data. Book covers in the public catalogue are fetched by ISBN from covers.openlibrary.org (Internet Archive) — that server sees the IP address and the ISBN, nothing else; if the catalogue lists a scanned cover, it is loaded from the address given in the catalogue, and that server sees the IP address. Both are turned off in “Settings › Data › Covers from the internet”. Personal screens (reading history, borrowed books, “Want to read”, “For you”, the card, and a book’s page opened from them) never load covers from the internet — there covers are drawn on the phone." resource-id="" class="android.widget.TextView" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1555][1027,2337]" /></node><node index="1" text="" resource-id="" class="android.view.View" package="org.chyavorec.app" content-desc="" checkable="false" checked="false" cli