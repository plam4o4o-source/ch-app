# Конфигурация за build (копирай като .env — .env НЕ се качва в Git).
# Всяка стойност може да се зададе и като променлива на средата или -PИМЕ=стойност.

# Сайтът на читалището (статичен сайт във Vercel): новини, събития, страници, галерия, документи.
API_BASE_URL=https://chyavorec.org

# Публичният каталог на InvLib: основен адрес | резервен адрес (разделени с |).
CATALOG_URLS=https://raw.githubusercontent.com/plam4o4o-source/yavorec-katalog/main/katalog.json|https://cdn.jsdelivr.net/gh/plam4o4o-source/yavorec-katalog@main/katalog.json

# Мостът за онлайн достъп на читатели (профил, заемания, членство) — Vercel
# функция в сайта на читалището; договорът е в docs/API.md. Само https://.
# Ако мостът още не е включен, приложението показва „все още не е достъпно“.
INFLIB_API_URL=https://chyavorec.org/api/invlib/yavorec

# Автоматично обновяване на APK, инсталиран извън Google Play (само prodRelease):
# update.json към последното GitHub Release. Празно = без проверка за обновления.
UPDATE_MANIFEST_URL=https://github.com/plam4o4o-source/ch-app/releases/latest/download/update.json

# development | production (production build винаги е production).
APP_ENV=development

# Само за dev flavor: true = читателските екрани ползват ясно маркирани ДЕМО данни.
# Production flavor игнорира тази стойност (демо кодът не съществува там).
USE_MOCK_DATA=true

# Номер на версията за Google Play (увеличава се при всяко качване).
VERSION_CODE=1

# Подписване на release (НЕ пиши реалните пароли тук, ако файлът се споделя).
SIGNING_STORE_FILE=
SIGNING_STORE_PASSWORD=
SIGNING_KEY_ALIAS=
SIGNING_KEY_PASSWORD=
