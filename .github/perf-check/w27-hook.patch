+package org.chyavorec.app
+
+import android.os.Build
+import android.os.Looper
+import android.os.Trace
+import android.util.Printer
+
+/**
+ * W27 DEBUG ONLY (branch debug/w27-cat, emulator builds, never released): every message of the main
+ * looper becomes a trace section named after its handler and callback ("msg Handler (…) callback: what"),
+ * so work outside Choreographer#doFrame (coroutine resumptions on Dispatchers.Main, posted runnables)
+ * is attributable in Perfetto/atrace. Below API 29 app sections need setAppTracingAllowed (hidden, not
+ * restricted on API 26-27) because a release build is not debuggable.
+ */
+object W27Trace {
+    private val hash = Regex("\\{[0-9a-f]+\\}|@[0-9a-f]{4,}")
+
+    fun install() {
+        if (Build.VERSION.SDK_INT < 29) runCatching {
+            Trace::class.java.getMethod("setAppTracingAllowed", Boolean::class.javaPrimitiveType).invoke(null, true)
+        }
+        Looper.getMainLooper().setMessageLogging(object : Printer {
+            private var open = 0
+            override fun println(x: String) {
+                if (x.startsWith(">>>>> Dispatching to ")) {
+                    if (enabled()) {
+                        Trace.beginSection(("msg " + x.substring(21).replace(hash, "")).take(120))
+                        open++
+                    }
+                } else if (x.startsWith("<<<<< Finished to ") && open > 0) {
+                    open--
+                    Trace.endSection()
+                }
+            }
+        })
+    }
+
+    private val isTagEnabled by lazy {
+        runCatching { Trace::class.java.getMethod("isTagEnabled", Long::class.javaPrimitiveType) }.getOrNull()
+    }
+
+    private fun enabled(): Boolean =
+        if (Build.VERSION.SDK_INT >= 29) Trace.isEnabled()
+        else runCatching { isTagEnabled?.invoke(null, 1L shl 12) as? Boolean }.getOrNull() ?: false
+}
